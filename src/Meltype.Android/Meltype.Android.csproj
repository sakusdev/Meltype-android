<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>org.sakusdev.meltype.android</ApplicationId>
    <ApplicationTitle>Meltype for Android</ApplicationTitle>
    <ApplicationVersion>2002</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.2</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
  </ItemGroup>

  <ItemGroup Condition="Exists('jniLibs/arm64-v8a/libmeltype_mozc.so')">
    <AndroidNativeLibrary Update="jniLibs/arm64-v8a/libmeltype_mozc.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <Target Name="RequireAndroidLicenses" BeforeTargets="Build">
    <Error Condition="'$(Configuration)' == 'Release' And !Exists('Assets/licenses/NOTICE.txt')"
           Text="Generate Android license assets with android/distribution.py prepare before building a Release APK." />
  </Target>
</Project>
